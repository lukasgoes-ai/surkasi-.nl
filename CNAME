<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>⚔️ De Echte Krijger ⚔️</title>

<style>
* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    margin: 0;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #0f172a;
    color: white;
    touch-action: none;
}

#game {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle, #334155, #0f172a 75%);
}

canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

/* BOVENBALK */

#topBar {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: min(94%, 720px);

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 10px 15px;

    border-radius: 20px;

    background: rgba(15,23,42,.82);
    backdrop-filter: blur(8px);

    box-shadow: 0 5px 20px rgba(0,0,0,.35);

    z-index: 5;
}

#warriorName {
    font-size: 17px;
    font-weight: bold;
}

#hearts {
    font-size: 24px;
    letter-spacing: 2px;
}

#timer {
    font-size: 22px;
    font-weight: bold;
    min-width: 55px;
    text-align: center;
}

#message {
    position: absolute;

    top: 82px;
    left: 50%;

    transform: translateX(-50%);

    width: 92%;
    max-width: 650px;

    text-align: center;

    font-size: 17px;
    font-weight: bold;

    text-shadow: 0 2px 6px black;

    pointer-events: none;

    z-index: 5;
}

/* STARTSCHERM */

#menu,
#endScreen {
    position: absolute;
    inset: 0;

    z-index: 20;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    padding: 25px;

    background:
        radial-gradient(
            circle at center,
            rgba(51,65,85,.97),
            rgba(2,6,23,.99)
        );

    text-align: center;
}

#menu h1 {
    font-size: clamp(35px, 9vw, 65px);
    margin: 0 0 8px;

    text-shadow: 0 5px 20px rgba(0,0,0,.7);
}

#menu p {
    font-size: 18px;
    line-height: 1.5;
    opacity: .9;

    margin-bottom: 28px;
}

.characters {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
}

.character {
    border: none;

    width: 130px;
    height: 150px;

    border-radius: 25px;

    color: white;

    font-size: 20px;
    font-weight: bold;

    cursor: pointer;

    box-shadow: 0 10px 25px rgba(0,0,0,.4);

    transition: transform .15s;
}

.character:active {
    transform: scale(.93);
}

.character span {
    display: block;
    font-size: 55px;
    margin-bottom: 10px;
}

.lukas {
    background: linear-gradient(145deg,#ef4444,#991b1b);
}

.jurre {
    background: linear-gradient(145deg,#facc15,#ca8a04);
    color: #291b00;
}

.sanne {
    background: linear-gradient(145deg,#3b82f6,#1e40af);
}

/* EINDSCHERM */

#endScreen {
    display: none;
}

#endEmoji {
    font-size: 80px;
    animation: bounce 1s infinite alternate;
}

#endTitle {
    font-size: clamp(32px,8vw,55px);
    margin: 10px 0;
}

#endText {
    max-width: 650px;

    font-size: 19px;
    line-height: 1.6;
}

#restart {
    margin-top: 20px;

    border: none;
    border-radius: 18px;

    padding: 15px 30px;

    font-size: 18px;
    font-weight: bold;

    cursor: pointer;

    background: white;
    color: #111827;

    box-shadow: 0 8px 20px rgba(0,0,0,.3);
}

/* JOYSTICK */

#joystick {
    position: absolute;

    left: 25px;
    bottom: 25px;

    width: 150px;
    height: 150px;

    border-radius: 50%;

    background: rgba(255,255,255,.10);

    border: 2px solid rgba(255,255,255,.18);

    backdrop-filter: blur(5px);

    z-index: 10;
}

#joystickKnob {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 65px;
    height: 65px;

    transform: translate(-50%,-50%);

    border-radius: 50%;

    background: rgba(255,255,255,.35);

    border: 2px solid rgba(255,255,255,.5);

    box-shadow: 0 5px 15px rgba(0,0,0,.3);
}

#joystickText {
    position: absolute;

    left: 50%;
    top: 50%;

    transform: translate(-50%,-50%);

    pointer-events: none;

    font-size: 25px;
}

/* ANIMATIES */

@keyframes bounce {
    from {
        transform: translateY(0);
    }

    to {
        transform: translateY(-12px);
    }
}

.damage {
    animation: hit .35s 2;
}

@keyframes hit {

    0%,100% {
        opacity: 1;
    }

    50% {
        opacity: .2;
    }
}

@media (max-width:500px) {

    #joystick {
        width: 135px;
        height: 135px;
    }

    #joystickKnob {
        width: 60px;
        height: 60px;
    }

}
</style>
</head>

<body>

<div id="game">

<canvas id="canvas"></canvas>

<div id="topBar">

    <div id="warriorName">
        ⚔️ Krijger
    </div>

    <div id="hearts">
        ❤️❤️❤️
    </div>

    <div id="timer">
        70
    </div>

</div>

<div id="message">
    🛡️ Overleef de strijd!
</div>


<!-- JOYSTICK -->

<div id="joystick">

    <div id="joystickKnob"></div>

    <div id="joystickText">
        🕹️
    </div>

</div>


<!-- STARTSCHERM -->

<div id="menu">

    <h1>
        ⚔️ De Echte Krijger ⚔️
    </h1>

    <p>
        Kies je krijger en probeer 70 seconden te overleven!<br>
        🏆 Alleen de echte krijger haalt het einde!
    </p>

    <div class="characters">

        <button
            class="character lukas"
            onclick="chooseWarrior('Lukas','🟥')">

            <span>🟥</span>
            Lukas

        </button>

        <button
            class="character jurre"
            onclick="chooseWarrior('Jurre','🟨')">

            <span>🟨</span>
            Jurre

        </button>

        <button
            class="character sanne"
            onclick="chooseWarrior('Sanne','🟦')">

            <span>🟦</span>
            Sanne

        </button>

    </div>

</div>


<!-- EINDSCHERM -->

<div id="endScreen">

    <div id="endEmoji">
        🏆❤️
    </div>

    <h1 id="endTitle">
        Goed gespeeld!
    </h1>

    <p id="endText"></p>

    <button id="restart" onclick="location.reload()">
        🔄 Nog een keer spelen
    </button>

</div>

</div>


<script>

const canvas = document.getElementById("canvas");

const ctx = canvas.getContext("2d");

let W;
let H;

function resize() {

    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;

}

resize();

window.addEventListener("resize",resize);


/* -----------------------------
   GAME VARIABELEN
----------------------------- */

let gameRunning = false;

let warrior = "";
let warriorEmoji = "";

let timeLeft = 70;

let hearts = 3;

let lastTime = 0;

let timerAccumulator = 0;

let enemies = [];

let heartsItems = [];

let particles = [];


/* -----------------------------
   BESTURING
----------------------------- */

let keys = {

    up:false,
    down:false,
    left:false,
    right:false

};


/* -----------------------------
   SPELER
----------------------------- */

let player = {

    x:0,
    y:0,

    radius:24,

    speed:270,

    invulnerable:0

};


/* -----------------------------
   KRIJGER KIEZEN
----------------------------- */

function chooseWarrior(name,emoji) {

    warrior = name;

    warriorEmoji = emoji;

    alert(
        "⚔️ Klaar om de strijd te winnen, " +
        name +
        "?"
    );

    document.getElementById("menu").style.display = "none";

    document.getElementById("warriorName").textContent =
        emoji + " " + name;

    startGame();

}


/* -----------------------------
   GAME START
----------------------------- */

function startGame() {

    gameRunning = true;

    player.x = W / 2;
    player.y = H / 2;

    hearts = 3;

    timeLeft = 70;

    enemies = [];
    heartsItems = [];
    particles = [];


    /*
       MONSTER 1
       🟧 ORANJE
       SNELHEID 1.00
    */

    createEnemy(
        1.00,
        "👹",
        "monster1",
        "#f97316"
    );


    /*
       MONSTER 2
       🟩 GROEN
       SNELHEID 1.25
    */

    createEnemy(
        1.25,
        "👺",
        "monster2",
        "#22c55e"
    );


    lastTime = performance.now();

    requestAnimationFrame(gameLoop);

}


/* -----------------------------
   MONSTER MAKEN
----------------------------- */

function createEnemy(
    speed,
    emoji,
    type,
    color
) {

    let side =
        Math.floor(
            Math.random()*4
        );

    let x;
    let y;


    if(side === 0) {

        x = -60;

        y = Math.random()*H;

    }


    if(side === 1) {

        x = W+60;

        y = Math.random()*H;

    }


    if(side === 2) {

        x = Math.random()*W;

        y = -60;

    }


    if(side === 3) {

        x = Math.random()*W;

        y = H+60;

    }


    enemies.push({

        x:x,
        y:y,

        radius:28,

        speed:70*speed,

        emoji:emoji,

        type:type,

        color:color,

        hitCooldown:0

    });

}


/* -----------------------------
   GROTE MONSTER
   KOMT BIJ 45 SEC
----------------------------- */

function createBigMonster() {

    createEnemy(

        .45,

        "👹",

        "monster3",

        "#ffffff"

    );


    let enemy =
        enemies[enemies.length-1];


    enemy.radius = 46;

    enemy.speed = 38;


    showMessage(
        "😱 PAS OP! HET GROTE MONSTER KOMT!"
    );


    shakeScreen();

}


/* -----------------------------
   SUPER SLOOM MONSTER
   KOMT BIJ 10 SEC
----------------------------- */

function createSlowMonster() {

    createEnemy(

        .18,

        "👾",

        "monster4",

        "#a855f7"

    );


    let enemy =
        enemies[enemies.length-1];


    enemy.radius = 38;

    enemy.speed = 15;


    showMessage(
        "🐌 Een SUPER SLOOM monster verschijnt!"
    );

}


/* -----------------------------
   GROEN HARTJE
----------------------------- */

function spawnHeart() {

    heartsItems.push({

        x:
            50 +
            Math.random()*
            Math.max(100,W-100),

        y:
            130 +
            Math.random()*
            Math.max(100,H-220),

        radius:22,

        life:8

    });


    showMessage(
        "💚 Een groen hartje is verschenen!"
    );

}


/* -----------------------------
   GAME LOOP
----------------------------- */

function gameLoop(now) {

    if(!gameRunning)
        return;


    let dt =
        (now-lastTime)/1000;


    dt =
        Math.min(
            dt,
            .05
        );


    lastTime = now;


    timerAccumulator += dt;


    if(timerAccumulator >= 1) {

        timerAccumulator--;

        timeLeft--;

        updateTimerEvents();

    }


    update(dt);

    draw();


    if(gameRunning) {

        requestAnimationFrame(gameLoop);

    }

}


/* -----------------------------
   TIMER EVENTS
----------------------------- */

function updateTimerEvents() {

    document.getElementById("timer").textContent =
        timeLeft;


    /*
       HARTJES
       65 / 45 / 25
    */

    if(
        timeLeft === 65 ||
        timeLeft === 45 ||
        timeLeft === 25
    ) {

        spawnHeart();

    }


    /*
       GROOT MONSTER
       45 SEC
    */

    if(timeLeft === 45) {

        createBigMonster();

    }


    /*
       SUPER SLOOM MONSTER
       10 SEC
    */

    if(timeLeft === 10) {

        createSlowMonster();

    }


    /*
       WIN
    */

    if(timeLeft <= 0) {

        winGame();

    }

}


/* -----------------------------
   UPDATE
----------------------------- */

function update(dt) {

    updatePlayer(dt);

    updateEnemies(dt);

    updateHeartItems(dt);

    updateParticles(dt);

}


/* -----------------------------
   SPELER
----------------------------- */

function updatePlayer(dt) {

    let dx = 0;
    let dy = 0;


    if(keys.left)
        dx--;

    if(keys.right)
        dx++;

    if(keys.up)
        dy--;

    if(keys.down)
        dy++;


    if(dx !== 0 || dy !== 0) {

        let length =
            Math.sqrt(
                dx*dx +
                dy*dy
            );


        dx /= length;
        dy /= length;


        player.x +=
            dx *
            player.speed *
            dt;


        player.y +=
            dy *
            player.speed *
            dt;

    }


    player.x =
        Math.max(
            30,
            Math.min(
                W-30,
                player.x
            )
        );


    player.y =
        Math.max(
            120,
            Math.min(
                H-30,
                player.y
            )
        );


    if(player.invulnerable > 0) {

        player.invulnerable -= dt;

    }

}


/* -----------------------------
   MONSTERS UPDATE
----------------------------- */

function updateEnemies(dt) {

    enemies.forEach(enemy => {

        let dx =
            player.x -
            enemy.x;


        let dy =
            player.y -
            enemy.y;


        let distance =
            Math.sqrt(
                dx*dx +
                dy*dy
            );


        if(distance > 1) {

            dx /= distance;

            dy /= distance;


            enemy.x +=
                dx *
                enemy.speed *
                dt;


            enemy.y +=
                dy *
                enemy.speed *
                dt;

        }


        if(enemy.hitCooldown > 0) {

            enemy.hitCooldown -= dt;

        }


        /*
           BOTSING
        */

        if(
            distance <
            player.radius +
            enemy.radius
        ) {

            if(
                player.invulnerable <= 0 &&
                enemy.hitCooldown <= 0
            ) {

                damagePlayer();

                enemy.hitCooldown = 1.2;


                enemy.x -=
                    dx*45;


                enemy.y -=
                    dy*45;

            }

        }

    });

}


/* -----------------------------
   SCHADE
----------------------------- */

function damagePlayer() {

    hearts--;

    player.invulnerable = 1.2;


    updateHearts();


    createParticles(
        player.x,
        player.y,
        "💥"
    );


    showMessage(
        "💥 AU! Je bent geraakt!"
    );


    document
        .getElementById("game")
        .classList.add("damage");


    setTimeout(()=>{

        document
            .getElementById("game")
            .classList.remove("damage");

    },400);


    if(hearts <= 0) {

        loseGame();

    }

}


/* -----------------------------
   HARTJES
----------------------------- */

function updateHearts() {

    let result = "";


    for(
        let i=0;
        i<3;
        i++
    ) {

        result +=
            i<hearts
            ? "❤️"
            : "🖤";

    }


    document.getElementById("hearts").textContent =
        result;

}


/* -----------------------------
   GROENE HARTJES UPDATE
----------------------------- */

function updateHeartItems(dt) {

    heartsItems.forEach(item => {

        item.life -= dt;


        let dx =
            player.x-item.x;


        let dy =
            player.y-item.y;


        let distance =
            Math.sqrt(
                dx*dx +
                dy*dy
            );


        if(
            distance <
            player.radius +
            item.radius
        ) {

            if(hearts < 3) {

                hearts++;


                updateHearts();


                createParticles(
                    item.x,
                    item.y,
                    "💚"
                );


                showMessage(
                    "💚 Je hebt een leven teruggekregen!"
                );

            }

            else {

                showMessage(
                    "💚 Je hebt al 3 levens!"
                );

            }


            item.life = 0;

        }

    });


    heartsItems =
        heartsItems.filter(
            item => item.life > 0
        );

}


/* -----------------------------
   TEKENEN
----------------------------- */

function draw() {

    ctx.clearRect(
        0,
        0,
        W,
        H
    );


    drawArena();

    drawHeartItems();

    drawEnemies();

    drawPlayer();

    drawParticles();

}


/* -----------------------------
   ARENA
----------------------------- */

function drawArena() {

    ctx.fillStyle =
        "#172033";


    ctx.fillRect(
        0,
        0,
        W,
        H
    );


    ctx.strokeStyle =
        "rgba(255,255,255,.035)";


    ctx.lineWidth = 1;


    let size = 45;


    for(
        let x=0;
        x<W;
        x+=size
    ) {

        ctx.beginPath();

        ctx.moveTo(
            x,
            100
        );

        ctx.lineTo(
            x,
            H
        );

        ctx.stroke();

    }


    for(
        let y=100;
        y<H;
        y+=size
    ) {

        ctx.beginPath();

        ctx.moveTo(
            0,
            y
        );

        ctx.lineTo(
            W,
            y
        );

        ctx.stroke();

    }

}


/* -----------------------------
   SPELER TEKENEN
----------------------------- */

function drawPlayer() {

    ctx.save();


    if(
        player.invulnerable > 0
    ) {

        ctx.globalAlpha =
            Math.sin(
                performance.now()/60
            ) > 0
            ? 1
            : .35;

    }


    ctx.beginPath();


    ctx.arc(
        player.x,
        player.y,
        player.radius+7,
        0,
        Math.PI*2
    );


    ctx.fillStyle =
        "rgba(255,255,255,.15)";


    ctx.fill();


    ctx.font =
        "42px Arial";


    ctx.textAlign =
            